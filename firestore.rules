rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isOwner() {
      return request.auth != null && request.auth.uid == 'HfksT06CgFUkZ9s4vrzEGs85O562';
    }
    function isAdmin() {
      return isOwner() || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isPumgodaAdmin() {
      return isOwner() || exists(/databases/$(database)/documents/pumgodaAdmins/$(request.auth.uid));
    }
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Pumgoda — admin registry ────────────────────────────────────────────
    match /admins/{uid} {
      allow get:    if isUser(uid);
      allow list:   if isOwner();
      allow write:  if isOwner();
    }

    // ── Pumgoda — Pumgoda-only admin registry (catalog access, no other tabs) ─
    match /pumgodaAdmins/{uid} {
      allow get:    if isUser(uid);
      allow list:   if isOwner();
      allow write:  if isOwner();
    }

    // ── Pumgoda — user profiles (landing page onAuthStateChanged) ───────────
    match /userProfiles/{uid} {
      allow read:  if isAdmin();
      allow write: if isUser(uid)
                   && request.resource.data.name   is string
                   && request.resource.data.name.size()  <= 200
                   && request.resource.data.email  is string
                   && request.resource.data.email.size() <= 320
                   && !request.resource.data.name.matches('.*[<>].*')
                   && !request.resource.data.email.matches('.*[<>].*');
    }

    // ── Pumgoda — user backups ──────────────────────────────────────────────
    match /userBackups/{uid}/snapshots/{snapId} {
      allow read, write: if isUser(uid);
    }

    // ── Pumgoda — places (Firestore catalog) ────────────────────────────────
    match /places/{placeId} {
      allow read:   if true;
      allow write:  if isAdmin() || isPumgodaAdmin();
    }

    // ── Pumgoda — place votes ───────────────────────────────────────────────
    // vote values are 'up'|'paw'|'warn' (VoteButtons.jsx's three signals) —
    // this previously said ['up','down'], a stale rule that was silently
    // rejecting every 'paw' and 'warn' vote write (client did an optimistic
    // UI update, then rolled it back on the permission-denied response).
    // note is an optional short free-text tip attached to the voter's own
    // vote (e.g. "pet fee now applies weekends"), settable on create or via
    // a later update — same size cap enforced both times.
    match /placeVotes/{voteId} {
      // Public read — vote tallies are meant to inform anyone browsing,
      // signed in or not (useVotesFs.js subscribes unconditionally on
      // mount); only submitting/editing a vote requires being signed in.
      allow read:   if true;
      allow create: if signedIn()
                    && request.resource.data.uid    == request.auth.uid
                    && request.resource.data.vote   in ['up','paw','warn']
                    && request.resource.data.placeId is string
                    && (!('note' in request.resource.data)
                        || request.resource.data.note == null
                        || (request.resource.data.note is string && request.resource.data.note.size() <= 140));
      allow update: if isUser(resource.data.uid)
                    && request.resource.data.uid    == resource.data.uid
                    && request.resource.data.placeId == resource.data.placeId
                    && request.resource.data.vote   in ['up','paw','warn']
                    && (!('note' in request.resource.data)
                        || request.resource.data.note == null
                        || (request.resource.data.note is string && request.resource.data.note.size() <= 140));
      allow delete: if isUser(resource.data.uid);
    }

    // ── Pumgoda — place suggestions (in-app "Suggest a place" queue) ────────
    // A doc's existence IS the pending state — approving converts it into a
    // places/ doc and deletes it; rejecting just deletes it. Only admin or
    // Pumgoda-only admin may read the queue or delete entries. Anyone may
    // create one, signed in or not (same openness as shareLinks below) —
    // submittedBy is whatever the client sends, unverified when anonymous.
    // targetPlaceId (optional) marks this as an edit-suggestion for an
    // existing place rather than a new-place suggestion; admin console
    // resolves it against places/{targetPlaceId} instead of creating new.
    match /placeSuggestions/{suggestionId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && (!('googleMapsUrl' in request.resource.data)
                        || request.resource.data.googleMapsUrl == null
                        || (request.resource.data.googleMapsUrl is string && request.resource.data.googleMapsUrl.size() <= 500))
                    && (!('note' in request.resource.data)
                        || request.resource.data.note == null
                        || (request.resource.data.note is string && request.resource.data.note.size() <= 2000))
                    && request.resource.data.submittedBy is map
                    && (!('uid' in request.resource.data.submittedBy)
                        || request.resource.data.submittedBy.uid == null
                        || request.resource.data.submittedBy.uid is string)
                    && (!('name' in request.resource.data.submittedBy)
                        || request.resource.data.submittedBy.name == null
                        || (request.resource.data.submittedBy.name is string && request.resource.data.submittedBy.name.size() <= 200))
                    && (!('policy' in request.resource.data) || request.resource.data.policy is map)
                    && (!('priceTier' in request.resource.data)
                        || request.resource.data.priceTier == null
                        || request.resource.data.priceTier in ['', '$', '$$', '$$$'])
                    && (!('photos' in request.resource.data)
                        || (request.resource.data.photos is list && request.resource.data.photos.size() <= 5))
                    && (!('targetPlaceId' in request.resource.data)
                        || (request.resource.data.targetPlaceId is string && request.resource.data.targetPlaceId.size() <= 200));
      allow read, delete: if isAdmin() || isPumgodaAdmin();
      allow update: if false;
    }

    // ── Pumgoda — shared trips ──────────────────────────────────────────────
    match /sharedTrips/{tripId} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && request.resource.data.ownerUid  == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members   == resource.data.members
        )
        ||
        (
          !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.ownerUid  == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name      == resource.data.name
          && request.resource.data.placeIds  == resource.data.placeIds
        )
      );
      allow delete: if isUser(resource.data.ownerUid);
    }

    // ── Pumgoda — user saved places ─────────────────────────────────────────
    match /userPlaces/{uid} {
      allow read:  if isUser(uid) || isAdmin();
      allow write: if isUser(uid)
                   && request.resource.data.savedIds is list
                   && request.resource.data.savedIds.size() < 10000
                   && (!('lastModified' in request.resource.data)
                       || request.resource.data.lastModified is timestamp
                       || request.resource.data.lastModified is number);
    }

    // ── Pumgoda — user trips ────────────────────────────────────────────────
    match /userTrips/{uid} {
      allow read, write: if isUser(uid);
    }

    // ── Bill Splitter — user bills ──────────────────────────────────────────
    match /userBills/{uid} {
      allow read:  if isUser(uid) || isAdmin();
      allow write: if isUser(uid)
                   && (!('history' in request.resource.data)
                       || (request.resource.data.history is list
                           && request.resource.data.history.size() <= 20))
                   && (!('lastModified' in request.resource.data)
                       || request.resource.data.lastModified is timestamp
                       || request.resource.data.lastModified is number)
                   && (!('trips' in request.resource.data)
                       || request.resource.data.trips is list)
                   && (!('tripsLastEdit' in request.resource.data)
                       || request.resource.data.tripsLastEdit is number);
    }
    match /userBills/{uid}/trips/{tripId} {
      allow read:  if isUser(uid) || isAdmin();
      allow write: if isUser(uid);
    }

    // ── Bill Splitter — share links ─────────────────────────────────────────
    match /shareLinks/{shortId} {
      allow read:   if true;
      allow create: if true
                && request.resource.data.payload    is string
                && request.resource.data.payload.size() <= 100000
                && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is number)
                && (request.resource.data.expiresAt is timestamp || request.resource.data.expiresAt is number)
                && (!('createdBy' in request.resource.data)
                    || request.resource.data.createdBy is string
                    || request.resource.data.createdBy == null);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ── Bill Splitter — saved payees ─────────────────────────────────────────
    match /userPayees/{uid} {
      allow read:  if isUser(uid);
      allow write: if isUser(uid)
                   && request.resource.data.payees is list
                   && request.resource.data.payees.size() <= 20;
    }

    // ── Stock Ranges — user watchlist ───────────────────────────────────────
    match /userStockRanges/{uid} {
      allow read:  if isUser(uid) || isAdmin();
      allow write: if isUser(uid)
                   && request.resource.data.watchlist is list
                   && request.resource.data.watchlist.size() <= 100
                   && request.resource.data.range is string
                   && request.resource.data.currency is string
                   && (!('tags' in request.resource.data) || request.resource.data.tags is map)
                   && (!('knownFor' in request.resource.data)
                       || (request.resource.data.knownFor is map
                           // Only watchlisted/held symbols ever get an entry here, so this
                           // mirrors watchlist's own 100-symbol cap above — rules can't walk
                           // into each symbol's array to cap its length/entry size too, but
                           // bounding the number of keys still bounds the overall blast radius.
                           && request.resource.data.knownFor.size() <= 100))
                   && (!('holdings' in request.resource.data) || request.resource.data.holdings is map)
                   && (!('alerts' in request.resource.data)
                       || (request.resource.data.alerts is map
                           // Toggle-state mirror only (see useCloudSync.js) — the
                           // Worker's own KV copy is what the cron job actually
                           // reads, so this just needs the same shape/size bound
                           // as knownFor above, not deep validation.
                           && request.resource.data.alerts.size() <= 100))
                   && (!('portfolioHistory' in request.resource.data)
                       || (request.resource.data.portfolioHistory is map
                           && request.resource.data.portfolioHistory.size() <= 400))
                   && (!('lastModified' in request.resource.data)
                       || request.resource.data.lastModified is timestamp
                       || request.resource.data.lastModified is number);
    }

    // ── Nutritions — user data ───────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isUser(uid) || isAdmin();
      allow write: if isUser(uid)
                   && request.resource.data.size() < 200
                   && (!('stats'       in request.resource.data) || request.resource.data.stats       is map)
                   && (!('days'        in request.resource.data) || request.resource.data.days        is map)
                   && (!('weights'     in request.resource.data) || request.resource.data.weights     is map)
                   && (!('customFoods' in request.resource.data) || request.resource.data.customFoods is list);
    }

    // ── Backyard Rampage — cross-device save sync ───────────────────────────
    match /userGame/{uid} {
      allow read:  if isUser(uid);
      allow write: if isUser(uid)
                   && request.resource.data.seq          is number
                   && request.resource.data.lastModified is timestamp
                   && (!('reset' in request.resource.data)
                       || request.resource.data.reset is bool)
                   && (!('bank'          in request.resource.data) || request.resource.data.bank          is number)
                   && (!('bestWave'      in request.resource.data) || request.resource.data.bestWave      is number)
                   && (!('bestScore'     in request.resource.data) || request.resource.data.bestScore     is number)
                   && (!('rebirths'      in request.resource.data) || request.resource.data.rebirths      is number)
                   && (!('rebirthBonus'  in request.resource.data) || request.resource.data.rebirthBonus  is number)
                   && (!('playerName'    in request.resource.data) || (
                         request.resource.data.playerName is string
                         && request.resource.data.playerName.size() <= 16))
                   && (!('playerId'      in request.resource.data) || (
                         request.resource.data.playerId is string
                         && request.resource.data.playerId.size() <= 16))
                   && (!('gameSave'      in request.resource.data) || (
                         request.resource.data.gameSave is string
                         && request.resource.data.gameSave.size() <= 65536));
      allow update: if isUser(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['gameSave', 'lastModified'])
                    && request.resource.data.gameSave is string
                    && request.resource.data.gameSave.size() <= 65536;
    }

    // ── Backyard Rampage — all-time leaderboard ──────────────────────────────
    match /leaderboard/{uid} {
      allow read:  if signedIn();
      allow write: if isUser(uid)
                   && request.resource.data.keys().hasOnly(['name','pid','score','wave','rebirths','t'])
                   && request.resource.data.name     is string
                   && request.resource.data.name.size() <= 16
                   && request.resource.data.pid      is string
                   && request.resource.data.pid.size() <= 16
                   && request.resource.data.score    is number
                   && request.resource.data.score    >= 0
                   && request.resource.data.score    <= 100000000
                   && request.resource.data.wave     is number
                   && request.resource.data.wave     >= 0
                   && request.resource.data.wave     <= 10000
                   && request.resource.data.rebirths is number
                   && request.resource.data.rebirths >= 0
                   && request.resource.data.rebirths <= 1000
                   && request.resource.data.t        is timestamp;
    }

    // ── Backyard Rampage — challenge leaderboard ─────────────────────────────
    match /challengeBoard/{uid} {
      allow read:  if signedIn();
      allow write: if isUser(uid)
                   && request.resource.data.keys().hasOnly(['name','pid','score','wave','rebirths','t'])
                   && request.resource.data.name     is string
                   && request.resource.data.name.size() <= 16
                   && request.resource.data.pid      is string
                   && request.resource.data.pid.size() <= 16
                   && request.resource.data.score    is number
                   && request.resource.data.score    >= 0
                   && request.resource.data.score    <= 100000000
                   && request.resource.data.wave     is number
                   && request.resource.data.wave     >= 0
                   && request.resource.data.wave     <= 10000
                   && request.resource.data.rebirths is number
                   && request.resource.data.rebirths >= 0
                   && request.resource.data.rebirths <= 1000
                   && request.resource.data.t        is timestamp;
    }

    // ── Montreal 2026 — checklist sync ───────────────────────────────────────
    match /montrealChecklist/{uid} {
      allow read:  if request.auth != null
                   && request.auth.uid in ['ATNWbAURUwcuGPERNJFAvBNtRZc2', 'D17HauhxK5fSb8zkhvbzWzSIIQk2'];
      allow write: if isUser(uid)
                   && request.resource.data.checkedItems is list
                   && request.resource.data.checkedItems.size() <= 200
                   && (!('updatedAt' in request.resource.data)
                       || request.resource.data.updatedAt is timestamp
                       || request.resource.data.updatedAt is number)
                   && (!('displayName' in request.resource.data)
                       || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200));
    }

    match /tripTasks/{tripId} {
      allow read:  if request.auth != null
                   && request.auth.uid in ['ATNWbAURUwcuGPERNJFAvBNtRZc2', 'D17HauhxK5fSb8zkhvbzWzSIIQk2'];
      allow write: if request.auth != null
                   && request.auth.uid in ['ATNWbAURUwcuGPERNJFAvBNtRZc2', 'D17HauhxK5fSb8zkhvbzWzSIIQk2']
                   && request.resource.data.tasksJson is string
                   && request.resource.data.tasksJson.size() <= 10000;
    }

    // ── Montreal 2026 — checklist starter count (shared) ──────────────────────
    match /checklistStats/{tripId} {
      allow read:  if signedIn();
      allow write: if signedIn()
                   && request.resource.data.starterUids is list
                   && request.resource.data.starterUids.size() <= 500;
    }

    // ── Montreal 2026 — private booking details ────────────────────────────
    match /tripSecrets/{tripId} {
      allow read:  if request.auth != null
                   && request.auth.uid in ['ATNWbAURUwcuGPERNJFAvBNtRZc2', 'D17HauhxK5fSb8zkhvbzWzSIIQk2'];
      allow write: if request.auth != null
                   && request.auth.uid in ['ATNWbAURUwcuGPERNJFAvBNtRZc2', 'D17HauhxK5fSb8zkhvbzWzSIIQk2']
                   && (!('flightsHotel' in request.resource.data) || (request.resource.data.flightsHotel is string && request.resource.data.flightsHotel.size() <= 20000));
    }

    // ── Montreal 2026 — editable page content (itinerary/food/running) ────────
    match /tripContent/{tripId} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid in ['ATNWbAURUwcuGPERNJFAvBNtRZc2', 'D17HauhxK5fSb8zkhvbzWzSIIQk2']
                   && (!('itineraryJson' in request.resource.data) || (request.resource.data.itineraryJson is string && request.resource.data.itineraryJson.size() <= 50000))
                   && (!('foodJson' in request.resource.data) || (request.resource.data.foodJson is string && request.resource.data.foodJson.size() <= 20000))
                   && (!('runningJson' in request.resource.data) || (request.resource.data.runningJson is string && request.resource.data.runningJson.size() <= 20000))
                   && (!('packingJson' in request.resource.data) || (request.resource.data.packingJson is string && request.resource.data.packingJson.size() <= 50000));
    }

    // ── Village 77 — marketplace shops & handymen ───────────────────────────
    // Anyone may read. Posting and rating need a signed-in account: villagers
    // use LINE (Firebase custom token from the village-77 Worker), admins use
    // Google. Only the poster edits their post; the poster or an admin
    // deletes it. `verified` (an admin checked this villager really lives
    // here) can only be changed by an admin.
    // A shop is one seller with up to 30 items inside it. photos are URLs of
    // images stored in R2 by the village-77 Worker (village-77/worker/).
    //
    // Two admin levels, separate from the shared `admins` list (which would
    // make someone an admin of every app on the site):
    //   owner (isOwner)          — everything below, plus the members list
    //                              and granting / removing village admins.
    //   village admin            — listed in villageAdmins/{uid}: sees house
    //   (isVillageAdmin)           numbers, verifies villagers, deletes posts.
    function isVillageAdmin() {
      return signedIn()
          && (isOwner() || exists(/databases/$(database)/documents/villageAdmins/$(request.auth.uid)));
    }
    match /villageAdmins/{uid} {
      allow get:    if isUser(uid) || isOwner(); // the app checks its own role
      allow list:   if isOwner();
      allow create, update: if isOwner()
                            && request.resource.data.keys().hasOnly(['name', 'grantedAt'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 200
                            && request.resource.data.grantedAt == request.time;
      allow delete: if isOwner();
    }

    function validVillagePost(d) {
      return d.isResident is bool
          && d.name        is string && d.name.size()        <= 80
          && d.description is string && d.description.size() <= 1000
          && d.phone       is string && d.phone.size()       <= 30
          && d.line        is string && d.line.size()        <= 50
          && (!('instagram' in d) || (d.instagram is string && d.instagram.size() <= 60))
          && !('address' in d) // private — lives in villagePrivate below
          && (d.phone.size() > 0 || d.line.size() > 0 || ('instagram' in d && d.instagram.size() > 0))
          && d.photos is list && d.photos.size() <= 4
          && d.verified is bool
          && d.ownerUid is string;
    }
    function validVillageShop(d) {
      return validVillagePost(d)
          && d.name.size() > 0
          && d.categories is list && d.categories.size() > 0 && d.categories.size() <= 10
          && d.items is list && d.items.size() > 0 && d.items.size() <= 30
          // optional: how buyers get things, and opening hours (free text)
          && (!('delivery' in d) || (d.delivery is list && d.delivery.size() <= 2))
          && (!('hours' in d) || (d.hours is string && d.hours.size() <= 80));
    }
    function validVillageProvider(d) {
      return validVillagePost(d)
          && d.name.size() > 0
          && d.trades is list && d.trades.size() > 0 && d.trades.size() <= 10
          // optional: taking jobs right now? (false = busy)
          && (!('available' in d) || d.available is bool);
    }
    function villageCreate() {
      return signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.verified == false
          && request.resource.data.createdAt == request.time
          && (isVillageAdmin() || villageQuotaUsed());
    }
    // Daily post limit: up to 5 new shops / handymen per account per (UTC)
    // day. Each new post must bump villageQuota/{uid} in the same write
    // (getAfter = state after this write); the quota rule caps it at 5.
    function villageToday() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }
    function villageQuotaUsed() {
      let q = /databases/$(database)/documents/villageQuota/$(request.auth.uid);
      return getAfter(q).data.day == villageToday()
          && ((exists(q) && get(q).data.day == villageToday() && getAfter(q).data.count == get(q).data.count + 1)
              || ((!exists(q) || get(q).data.day != villageToday()) && getAfter(q).data.count == 1));
    }
    match /villageQuota/{uid} {
      allow get: if isUser(uid);
      allow create, update: if isUser(uid)
                            && request.resource.data.keys().hasOnly(['day', 'count'])
                            && request.resource.data.day == villageToday()
                            && request.resource.data.count is int
                            && request.resource.data.count <= 5
                            && ((resource != null && resource.data.day == villageToday() && request.resource.data.count == resource.data.count + 1)
                                || ((resource == null || resource.data.day != villageToday()) && request.resource.data.count == 1));
    }
    // Poster: anything but who owns it or when it was made. They can't mark
    // themselves verified, but can drop it (changing a verified house no.
    // sends the post back to the admins' "to check" list).
    function villageOwnerUpdate() {
      return isUser(resource.data.ownerUid)
          && request.resource.data.ownerUid  == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.verified == resource.data.verified || request.resource.data.verified == false);
    }
    // Admin: only flips the verified mark.
    function villageAdminUpdate() {
      return isVillageAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'updatedAt']);
    }
    match /villageShops/{postId} {
      allow read:   if true;
      allow create: if validVillageShop(request.resource.data) && villageCreate();
      allow update: if validVillageShop(request.resource.data) && (villageOwnerUpdate() || villageAdminUpdate());
      allow delete: if isUser(resource.data.ownerUid) || isVillageAdmin();
    }
    match /villageProviders/{postId} {
      allow read:   if true;
      allow create: if validVillageProvider(request.resource.data) && villageCreate();
      allow update: if validVillageProvider(request.resource.data) && (villageOwnerUpdate() || villageAdminUpdate());
      allow delete: if isUser(resource.data.ownerUid) || isVillageAdmin();
    }

    // 1–5 star ratings for handymen and shops, one per account per post: the
    // doc id is {postId}_{rater's uid} (village-77/src/hooks/useRatings.js),
    // so re-rating overwrites. The post must exist, and posters can't rate
    // themselves.
    function ratablePostNotMine(postId) {
      return (exists(/databases/$(database)/documents/villageProviders/$(postId))
              && get(/databases/$(database)/documents/villageProviders/$(postId)).data.ownerUid != request.auth.uid)
          || (exists(/databases/$(database)/documents/villageShops/$(postId))
              && get(/databases/$(database)/documents/villageShops/$(postId)).data.ownerUid != request.auth.uid);
    }
    match /villageRatings/{ratingId} {
      allow read: if true;
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['postId', 'stars', 'comment', 'name', 'updatedAt'])
                            && (!('comment' in request.resource.data)
                                || (request.resource.data.comment is string && request.resource.data.comment.size() <= 200))
                            && (!('name' in request.resource.data)
                                || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
                            && request.resource.data.postId is string
                            && ratingId == request.resource.data.postId + '_' + request.auth.uid
                            && ratablePostNotMine(request.resource.data.postId)
                            && request.resource.data.stars is int
                            && request.resource.data.stars >= 1
                            && request.resource.data.stars <= 5
                            && request.resource.data.updatedAt == request.time;
      // Admins, or anyone once the post is gone (cleanup after a delete).
      allow delete: if isVillageAdmin()
                    || (!exists(/databases/$(database)/documents/villageProviders/$(resource.data.postId))
                        && !exists(/databases/$(database)/documents/villageShops/$(resource.data.postId)));
    }

    // Village news (ประกาศหมู่บ้าน): lost & found, events, outages… Same
    // ownership as shops: signed-in to post, only the poster edits, poster or
    // admin deletes.
    function validVillageNews(d) {
      return d.kind in ['general', 'lost', 'event', 'outage', 'safety']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.body is string && d.body.size() <= 2000
          && d.photos is list && d.photos.size() <= 4
          && d.authorName is string && d.authorName.size() <= 80
          && d.ownerUid is string;
    }
    match /villageNews/{postId} {
      allow read:   if true;
      allow create: if validVillageNews(request.resource.data)
                    && signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update: if validVillageNews(request.resource.data)
                    && isUser(resource.data.ownerUid)
                    && request.resource.data.ownerUid  == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isUser(resource.data.ownerUid) || isVillageAdmin();
    }

    // ♥ saved shops / handymen, per account: { ids: [postId, …] }.
    match /villageFavorites/{uid} {
      allow read: if isUser(uid);
      allow write: if isUser(uid)
                   && request.resource.data.keys().hasOnly(['ids'])
                   && request.resource.data.ids is list
                   && request.resource.data.ids.size() <= 200;
    }

    // "Report this post": signed-in villagers flag a shop / handyman; admins
    // read them in the admin tab and dismiss (delete) them.
    match /villageReports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['postId', 'collection', 'reason', 'note', 'reporterUid', 'reporterName', 'createdAt'])
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.reason in ['wrong', 'notResident', 'scam', 'inappropriate', 'other']
                    && request.resource.data.note is string && request.resource.data.note.size() <= 300
                    && request.resource.data.reporterName is string && request.resource.data.reporterName.size() <= 80
                    && request.resource.data.collection in ['villageShops', 'villageProviders']
                    && exists(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.postId))
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isVillageAdmin();
    }

    // Category lists (marketplace categories, handyman types), edited by
    // admins in the admin tab: { market: [{key, th, en}], trades: [...] }.
    // Posts store the keys, so renaming keeps them; the app falls back to
    // its built-in lists while this doc doesn't exist.
    match /villageConfig/categories {
      allow read: if true;
      allow write: if isVillageAdmin()
                   && request.resource.data.keys().hasOnly(['market', 'trades', 'updatedAt', 'updatedBy'])
                   && request.resource.data.market is list && request.resource.data.market.size() <= 30
                   && request.resource.data.trades is list && request.resource.data.trades.size() <= 30
                   && request.resource.data.updatedBy == request.auth.uid;
    }

    // Everyone who has signed in to Village 77 (posted or not), for the
    // admin tab's member list. Each person writes only their own record.
    match /villageMembers/{uid} {
      allow get:    if isUser(uid) || isOwner();
      allow list:   if isOwner();
      allow create, update: if isUser(uid)
                            && request.resource.data.keys().hasOnly(['name', 'photoURL', 'provider', 'firstSeen', 'lastSeen'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 200
                            && request.resource.data.provider in ['line', 'google']
                            && request.resource.data.lastSeen == request.time;
      allow delete: if isOwner();
    }

    // A villager's house no. / soi, keyed by the post's id. Supporting info
    // for the random "do you really live here" checks: only admins read it
    // (the app's admin tab); the poster writes it but can never read it back.
    match /villagePrivate/{postId} {
      allow list:   if isVillageAdmin();
      // Admins, and the poster for their own post (so the edit form can show it).
      allow get:    if isVillageAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/$(resource.data.collection)/$(postId)).data.ownerUid == request.auth.uid);
      // The poster sets it from the post form; an admin can correct it from
      // the admin tab (their uid goes in updatedBy).
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['address', 'collection', 'updatedAt', 'updatedBy'])
                            && request.resource.data.address is string
                            && request.resource.data.address.size() > 0
                            && request.resource.data.address.size() <= 120
                            && request.resource.data.collection in ['villageShops', 'villageProviders']
                            && exists(/databases/$(database)/documents/$(request.resource.data.collection)/$(postId))
                            && (get(/databases/$(database)/documents/$(request.resource.data.collection)/$(postId)).data.ownerUid == request.auth.uid
                                || (isVillageAdmin() && request.resource.data.updatedBy == request.auth.uid));
      allow delete: if isVillageAdmin()
                    || (signedIn() && get(/databases/$(database)/documents/$(resource.data.collection)/$(postId)).data.ownerUid == request.auth.uid)
                    || !exists(/databases/$(database)/documents/$(resource.data.collection)/$(postId));
    }

match /strayDogs/{dogId} {
  allow read: if true;
  allow create: if request.auth != null;
  // disappearVotes (community "report as gone" consensus — dog-near-me
  // AGENTS notes) is only shape-validated here, not access-restricted:
  // every other update path (addSightingToDog, deleteSighting, mergeDogs)
  // is called by any signed-in user and never touches this field, so the
  // `in` check is a no-op for them. Writes that DO touch it (reportDisappeared/
  // retractDisappearedReport) must leave it as a bounded list.
  allow update: if request.auth != null
                && (!('disappearVotes' in request.resource.data)
                    || (request.resource.data.disappearVotes is list
                        && request.resource.data.disappearVotes.size() <= 999));
  allow delete: if request.auth != null;
  match /sightings/{sightingId} {
    allow read: if true;
    allow create: if request.auth != null;
    allow delete: if request.auth != null;
  }
  match /flags/{flagId} {
    allow read: if request.auth != null && request.auth.uid == 'HfksT06CgFUkZ9s4vrzEGs85O562';
    allow create: if request.auth != null;
    allow delete: if request.auth != null && request.auth.uid == 'HfksT06CgFUkZ9s4vrzEGs85O562';
  }
}

  }
}
