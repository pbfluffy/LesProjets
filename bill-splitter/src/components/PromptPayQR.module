.qrWrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px 0 4px;
}

.qrBox {
  background: #ffffff;
  padding: 8px;
  border-radius: var(--radius-md);
  border: 0.5px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}
