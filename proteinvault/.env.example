# Copy to .env.local (gitignored) and fill in your real values for local
# dev. In production, set these in your deploy platform's environment
# variable settings instead — never commit the real values.
VITE_ADMIN_EMAIL=you@example.com

# URL printed by `wrangler deploy` after deploying worker/ — see the
# "Import backend" section of README.md.
VITE_IMPORT_WORKER_URL=https://proteinvault-fetch.your-subdomain.workers.dev
